PORT=4001

# mitos_ai MySQL database (see docs/MITOS_AI_Platform_Implementation_Plan_REVISED.md)
DATABASE_URL="mysql://mitos_ai:PASSWORD@HOST:3306/mitos_ai"
SHADOW_DATABASE_URL="mysql://mitos_ai:PASSWORD@HOST:3306/mitos_ai_shadow"

# Read-only connection to the CORE backend database (maindb), for reading
# questions only. This user must be granted SELECT on maindb.question ONLY —
# never write access. See README.md "Core DB read access" for the exact
# CREATE USER / GRANT SQL and why it's enforced this way.
CORE_DB_READONLY_URL="mysql://mitos_ai_reader:PASSWORD@HOST:3306/maindb"

# Dedicated Redis instance for ai-service (cache + ephemeral session data)
REDIS_URL="redis://HOST:6379"

# Shared secret backend uses to call this service internally.
# Must match INTERNAL_AI_SERVICE_KEY in backend/.env once the proxy routes are added.
INTERNAL_SERVICE_KEY=

# Model providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional local-only provider — an Ollama instance running on this same
# machine (`ollama list` to see installed models). Not usable in
# production (nothing installed there).
OLLAMA_BASE_URL=http://localhost:11434

# When true, EVERY AI task (extraction, definitions, chat, ...) routes
# entirely through the local Ollama model below — primary AND fallback,
# no third-party provider anywhere in the chain, so this machine doesn't
# need real OPENAI_API_KEY/GEMINI_API_KEY/ANTHROPIC_API_KEY set at all.
# Leave unset (or false) in production — ecosystem.config.js's env block
# doesn't set this, so a PM2-deployed instance always ignores it and uses
# the real provider config below.
AI_LOCAL_ONLY=false
OLLAMA_MODEL=qwen2.5:14b

# Per-task model routing (optional — defaults live in src/router/modelConfig.js).
# Only used when AI_LOCAL_ONLY is not true. Verify these model IDs against
# each provider's current docs before deploying.
MODEL_KEYWORDS_PRIMARY=gemini-flash-latest
MODEL_KEYWORDS_FALLBACK=gpt-5-mini
MODEL_WORD_PRIMARY=gemini-flash-latest
MODEL_WORD_FALLBACK=gpt-5-mini
MODEL_CHAT_PRIMARY=gpt-5-mini
MODEL_CHAT_FALLBACK=gemini-flash-latest
MODEL_ANALYSIS_PRIMARY=claude-sonnet-5
MODEL_ANALYSIS_FALLBACK=gpt-5-mini
MODEL_STUDYPLAN_PRIMARY=gpt-5
MODEL_STUDYPLAN_FALLBACK=claude-sonnet-5

# Only origin allowed to call this service directly (should be the backend's own host, not a browser)
ALLOWED_CALLER_ORIGIN=http://localhost:5008

# Hard ceiling on dictionary batch size, independent of what the admin UI requests
DICTIONARY_MAX_BATCH_SIZE=50

# Delay between consecutive AI generation calls within a batch (ms).
# 15000 keeps Gemini's free-tier 5 req/min limit safe with margin — lower
# this once you're on a paid tier with higher throughput.
AI_CALL_DELAY_MS=15000
