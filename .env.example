PORT=4001

# mitos_ai MySQL database (see docs/MITOS_AI_Platform_Implementation_Plan_REVISED.md)
DATABASE_URL="mysql://mitos_ai:PASSWORD@HOST:3306/mitos_ai"
SHADOW_DATABASE_URL="mysql://mitos_ai:PASSWORD@HOST:3306/mitos_ai_shadow"

# Dedicated Redis instance for ai-service (cache + ephemeral session data)
REDIS_URL="redis://HOST:6379"

# Shared secret backend uses to call this service internally.
# Must match INTERNAL_AI_SERVICE_KEY in backend/.env once the proxy routes are added.
INTERNAL_SERVICE_KEY=

# Model providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Per-task model routing (optional — defaults live in src/router/modelConfig.js).
# Verify these model IDs against each provider's current docs before deploying.
MODEL_WORD_PRIMARY=gemini-2.5-flash
MODEL_WORD_FALLBACK=gpt-5-mini
MODEL_CHAT_PRIMARY=gpt-5-mini
MODEL_CHAT_FALLBACK=gemini-2.5-flash
MODEL_ANALYSIS_PRIMARY=claude-sonnet-5
MODEL_ANALYSIS_FALLBACK=gpt-5-mini
MODEL_STUDYPLAN_PRIMARY=gpt-5
MODEL_STUDYPLAN_FALLBACK=claude-sonnet-5

# Only origin allowed to call this service directly (should be the backend's own host, not a browser)
ALLOWED_CALLER_ORIGIN=http://localhost:5000
