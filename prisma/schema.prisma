generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Sprint 2 — AI Dictionary Generator
// See docs/MITOS_AI_Platform_Implementation_Plan_REVISED.md for full context.
// Models are added sprint by sprint rather than all at once.

model ai_dictionary {
  id                  Int      @id @default(autoincrement())
  // Normalized (lowercased, trimmed) keyword — the dedup key extracted from
  // questions across the whole bank, so "Mitochondria" and "mitochondria"
  // collapse into one entry instead of being generated/stored twice.
  term                String   @unique @db.VarChar(255)

  meaning             String?  @db.LongText
  simpleExplanation   String?  @db.LongText
  eli5                String?  @db.LongText
  detailedExplanation String?  @db.LongText
  mnemonic            String?  @db.LongText
  realLifeExample     String?  @db.LongText

  // pending | generating | completed | failed — drives the admin
  // "Generate Missing" / "Retry Failed" / "Progress" tools.
  status              String   @default("pending") @db.VarChar(20)
  failureReason       String?  @db.Text

  // Which model actually produced the current content, for traceability
  // when debugging a bad explanation.
  generatedByProvider String?  @db.VarChar(20)
  generatedByModel    String?  @db.VarChar(100)

  // Set when an admin hand-edits an entry — bulk regeneration jobs must
  // skip these instead of overwriting a human correction.
  manuallyEdited       Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  mappings              ai_dictionary_mapping[]

  @@index([status])
}

model ai_dictionary_mapping {
  id           Int      @id @default(autoincrement())
  dictionaryId Int

  // Soft reference to backend's core `question.id` — NOT a Prisma relation
  // and NOT a DB foreign key. That table lives in a different MySQL
  // database (the core schema), which Prisma/MySQL can't enforce
  // referential integrity across. Validity is the calling code's
  // responsibility (ai-service reads question data via backend's internal
  // read endpoint or the read-only bulk-job DB user — see the plan doc's
  // "Data access note" under Sprint 2).
  questionId   Int

  createdAt    DateTime @default(now())

  dictionary   ai_dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, questionId])
  @@index([questionId])
}

// One row per job type. Tracks a resumable cursor (the highest source
// record id processed so far) so "run a batch" always continues from
// where the last run stopped — whether that's the initial backlog or
// questions added to the bank weeks later. Never processes everything
// in one shot; batchSize + the caller's own cap bound each run.
model ai_job {
  id             Int       @id @default(autoincrement())
  type           String    @unique @db.VarChar(50)

  // pending | running | idle | failed — "idle" means the cursor caught up
  // to the source as of the last run, not that the job is permanently done;
  // it goes back to running the moment there's new data past the cursor.
  status         String    @default("pending") @db.VarChar(20)

  cursor         Int       @default(0)
  batchSize      Int       @default(20)

  totalProcessed Int       @default(0)
  totalCreated   Int       @default(0)
  totalSkipped   Int       @default(0)
  totalFailed    Int       @default(0)

  lastError      String?   @db.Text
  startedAt      DateTime?
  lastRunAt      DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
