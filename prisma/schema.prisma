generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// Sprint 2 — AI Dictionary Generator
// See docs/MITOS_AI_Platform_Implementation_Plan_REVISED.md for full context.
// Models are added sprint by sprint rather than all at once.

model ai_dictionary {
  id                  Int      @id @default(autoincrement())
  // Normalized (lowercased, trimmed) keyword — extracted from questions
  // across the whole bank, so "Mitochondria" and "mitochondria" collapse
  // into one entry instead of being generated/stored twice. Deduped
  // together with `subject` below (NOT unique on its own) — the same term
  // string can mean something different per subject (e.g. "cell" in
  // Biology vs. "cell" as in an electrochemical cell in Physics/
  // Chemistry; "horn" as an animal structure vs. a sound-producing
  // instrument), so each subject gets its own scoped entry rather than
  // one global definition winning for every subject that happens to use
  // the same word.
  term                String   @db.VarChar(255)

  // "physics" | "chemistry" | "biology" | "general" — see subjectMap.js
  // for how a question's subjectId resolves to this. "general" is the
  // fallback for a subjectId not yet in that map, and is also what every
  // entry created before this column existed carries (via the column
  // default on migration) — those stay as unscoped legacy entries rather
  // than being retroactively (and unreliably) reassigned a guessed subject.
  subject             String   @default("general") @db.VarChar(20)

  meaning             String?  @db.LongText
  simpleExplanation   String?  @db.LongText
  eli5                String?  @db.LongText
  detailedExplanation String?  @db.LongText
  mnemonic            String?  @db.LongText
  realLifeExample     String?  @db.LongText

  // pending | generating | completed | failed — drives the admin
  // "Generate Missing" / "Retry Failed" / "Progress" tools.
  status              String   @default("pending") @db.VarChar(20)
  failureReason       String?  @db.Text

  // Which model actually produced the current content, for traceability
  // when debugging a bad explanation.
  generatedByProvider String?  @db.VarChar(20)
  generatedByModel    String?  @db.VarChar(100)

  // Set when an admin hand-edits an entry — bulk regeneration jobs must
  // skip these instead of overwriting a human correction.
  manuallyEdited       Boolean  @default(false)

  createdAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt

  mappings              ai_dictionary_mapping[]

  @@unique([term, subject])
  @@index([status])
}

model ai_dictionary_mapping {
  id           Int      @id @default(autoincrement())
  dictionaryId Int

  // Soft reference to backend's core `question.id` — NOT a Prisma relation
  // and NOT a DB foreign key. That table lives in a different MySQL
  // database (the core schema), which Prisma/MySQL can't enforce
  // referential integrity across. Validity is the calling code's
  // responsibility (ai-service reads question data via backend's internal
  // read endpoint or the read-only bulk-job DB user — see the plan doc's
  // "Data access note" under Sprint 2).
  questionId   Int

  // "practice" (default — the existing main `question` table) |
  // "test_series" (`testseriesquestionbank`). Needed because those two
  // source tables have independent auto-increment id sequences — without
  // this, questionId alone can't say which table it refers to, and a
  // practice question and a test-series question could collide on the
  // same numeric id.
  source       String   @default("practice") @db.VarChar(20)

  createdAt    DateTime @default(now())

  dictionary   ai_dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)

  @@unique([dictionaryId, questionId, source])
  @@index([questionId])
  @@index([source, questionId])
}

// One row per job type. Tracks a resumable cursor (the highest source
// record id processed so far) so "run a batch" always continues from
// where the last run stopped — whether that's the initial backlog or
// questions added to the bank weeks later. Never processes everything
// in one shot; batchSize + the caller's own cap bound each run.
model ai_job {
  id             Int       @id @default(autoincrement())
  type           String    @unique @db.VarChar(50)

  // pending | running | idle | failed — "idle" means the cursor caught up
  // to the source as of the last run, not that the job is permanently done;
  // it goes back to running the moment there's new data past the cursor.
  status         String    @default("pending") @db.VarChar(20)

  cursor         Int       @default(0)
  batchSize      Int       @default(20)

  totalProcessed Int       @default(0)
  totalCreated   Int       @default(0)
  totalSkipped   Int       @default(0)
  totalFailed    Int       @default(0)

  lastError      String?   @db.Text
  startedAt      DateTime?
  lastRunAt      DateTime?

  // What the batch is doing right this second, e.g. "Question 542 (3/5):
  // generating explanation for 'refraction'" — so admin polling sees real
  // activity, not just totals that jump occasionally. Cleared (null) once
  // a run finishes or the job is otherwise idle.
  currentActivity      String? @db.VarChar(255)
  // Progress within THIS run specifically (resets every run), separate
  // from the lifetime totalProcessed/etc above — "2 of 5 questions in
  // this batch" is a different, more immediately useful number than
  // "13 processed ever".
  currentBatchTotal     Int?
  currentBatchProcessed Int?

  // Persisted (not just in-memory) so "keep running until I stop it" is a
  // durable intent — survives ai-service restarting, not just a flag that
  // resets to off the moment the process bounces. The loop itself checks
  // this after every single question, never mid-question, so Stop always
  // takes effect at a clean boundary.
  autoRunEnabled Boolean @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ai_chat_session {
  id         Int      @id @default(autoincrement())
  userId     Int
  questionId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  messages ai_chat_message[]

  @@unique([userId, questionId])
  @@index([userId])
}

model ai_chat_message {
  id                  Int      @id @default(autoincrement())
  sessionId           Int
  // "user" | "assistant"
  role                String   @db.VarChar(10)
  content             String   @db.LongText
  generatedByProvider String?  @db.VarChar(20)
  generatedByModel    String?  @db.VarChar(100)
  // Only ever set on assistant rows — a user message doesn't independently
  // consume tokens, the LLM call that answers it does. Used for admin usage
  // analytics (per-user token/cost totals); nothing before this field was
  // added has values here, so historical cost data starts from when this
  // shipped, not from the beginning of the chat feature.
  inputTokens         Int?     @default(0)
  outputTokens        Int?     @default(0)
  createdAt           DateTime @default(now())

  session ai_chat_session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}
